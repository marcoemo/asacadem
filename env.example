# Copia este archivo como .env y completa tu API key (NUNCA subas .env a GitHub)
OPENROUTER_API_KEY=
AGENT_MODEL=openai/gpt-6-luna
REASONING_EFFORT=low
# auto = intenta embeddings por OpenRouter y cae a embeddings locales si fallan
# openrouter | local
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=openai/text-embedding-3-small
